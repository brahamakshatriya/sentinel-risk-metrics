# =============================================================================
# Frontend (Next.js) - Environment Configuration
# =============================================================================
# Copy this file to .env.local and fill in your values
# For production on Vercel, set these in the Vercel dashboard (Project Settings > Environment Variables)

# Backend API URL - REQUIRED
# For local dev: http://localhost:8001
# For production: https://your-api.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8001