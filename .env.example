# =============================================================================
# Sentinel - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# For production, set ENVIRONMENT=production and configure all variables

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
ENVIRONMENT=development          # development | production
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# For Neon PostgreSQL (recommended for Render free tier)
# DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/dbname?sslmode=require
# For local PostgreSQL
# DATABASE_URL=postgresql://postgres:password@localhost:5432/riskmetrics
# For SQLite (development only - NOT for production)
DATABASE_URL=sqlite:///./riskmetrics.db

# -----------------------------------------------------------------------------
# External APIs
# -----------------------------------------------------------------------------
# FRED API Key for live risk-free rate (3-month T-bill yield)
# Get a free key at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# -----------------------------------------------------------------------------
# CORS (Production only)
# -----------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins
# Example: CORS_ALLOWED_ORIGINS=https://your-app.vercel.app,https://your-custom-domain.com
CORS_ALLOWED_ORIGINS=

# -----------------------------------------------------------------------------
# Frontend (Vercel/Next.js)
# -----------------------------------------------------------------------------
# Backend API URL for Next.js rewrites and client-side calls
# For local dev: http://localhost:8001
# For production: https://your-api.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8001

# -----------------------------------------------------------------------------
# S1 Availability Protection (all optional — safe defaults apply)
# -----------------------------------------------------------------------------
# S1_MC_CELLS_BUDGET=8000000
# S1_MC_GLOBAL_CONCURRENCY=2
# S1_MC_USER_CONCURRENCY=1
# S1_MC_TIMEOUT_SECONDS=60
# S1_INGEST_MAX_SYMBOL_DAYS=25000
# S1_INGEST_MAX_DATE_RANGE_DAYS=1825
# S1_INGEST_GLOBAL_CONCURRENCY=4
# S1_INGEST_USER_CONCURRENCY=2

# -----------------------------------------------------------------------------
# S2 External Resilience + Disclosure Hardening (all optional)
# -----------------------------------------------------------------------------
# S2_YAHOO_TIMEOUT_SECONDS=12        # per-attempt Yahoo timeout (10-15 target)
# S2_YAHOO_MAX_RETRIES=1             # hard-capped at 1 in code (0 disables)
# S2_FRED_TIMEOUT_SECONDS=10         # per-attempt FRED timeout
# S2_FRED_MAX_RETRIES=1              # hard-capped at 1 in code (0 disables)
# S2_JWKS_TTL_SECONDS=600            # JWKS cache TTL (~10 minutes)
# S2_JWKS_TIMEOUT_SECONDS=10         # JWKS fetch timeout
# S2_MAX_BODY_BYTES=1048576          # ~1 MB max JSON request body
# S2_MAX_HOLDINGS=100                # max holdings rows per portfolio
# S2_MAX_QUANTITY=1000000000         # max per-holding quantity
# S2_MAX_AVG_COST=10000000           # max per-share average cost
# S2_ENABLE_DOCS=false               # set true to expose /docs in production

# -----------------------------------------------------------------------------
# S3 Database Integrity + Abuse Controls (all optional)
# -----------------------------------------------------------------------------
# S3_DB_POOL_SIZE=5                    # Postgres pool base connections
# S3_DB_MAX_OVERFLOW=5                 # Postgres pool overflow cap
# S3_DB_POOL_TIMEOUT=10                # seconds waiting for a connection
# S3_DB_POOL_RECYCLE=300               # seconds before connection recycle
# S3_DB_POOL_PRE_PING=true             # validate connections on checkout
# S3_DB_STATEMENT_TIMEOUT_MS=0         # 0=disabled (deferred); ms when enabled
# S3_DAILY_INGEST_SYMBOL_DAYS=100000   # persistent per-user daily quota
# S3_MAX_PORTFOLIOS=50                 # max portfolios owned per user
# S3_MAX_SHARES_PER_PORTFOLIO=50       # max grants per portfolio
# S3_RATE_AUTH_READ_LIMIT=300          # dashboard reads per user per minute
# S3_RATE_AUTH_MUTATION_LIMIT=200      # CRUD writes per user per minute
# S3_RATE_SHARE_MUTATION_LIMIT=60      # share ops per user+portfolio per minute
# S3_ABUSE_WINDOW=300                  # abuse-signal window (seconds)
# S3_ABUSE_REPEATED_429=10             # repeated-429 signal threshold
# S3_ABUSE_REPEATED_403=10             # repeated-403 signal threshold
# S3_ABUSE_REPEATED_413=10             # repeated-413 signal threshold