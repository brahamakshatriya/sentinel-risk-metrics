# =============================================================================
# Sentinel - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# For production, set ENVIRONMENT=production and configure all variables

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
ENVIRONMENT=development          # development | production
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# For Neon PostgreSQL (recommended for Render free tier)
# DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/dbname?sslmode=require
# For local PostgreSQL
# DATABASE_URL=postgresql://postgres:password@localhost:5432/riskmetrics
# For SQLite (development only - NOT for production)
DATABASE_URL=sqlite:///./riskmetrics.db

# -----------------------------------------------------------------------------
# External APIs
# -----------------------------------------------------------------------------
# FRED API Key for live risk-free rate (3-month T-bill yield)
# Get a free key at: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# -----------------------------------------------------------------------------
# CORS (Production only)
# -----------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins
# Example: CORS_ALLOWED_ORIGINS=https://your-app.vercel.app,https://your-custom-domain.com
CORS_ALLOWED_ORIGINS=

# -----------------------------------------------------------------------------
# Frontend (Vercel/Next.js)
# -----------------------------------------------------------------------------
# Backend API URL for Next.js rewrites and client-side calls
# For local dev: http://localhost:8001
# For production: https://your-api.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:8001